{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["wrangler", "dotenvx"],
  "ignoreDependencies": ["@cyrus/typescript", "@biomejs/biome"],
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,sh}", "wrangler.json"],
      "ignoreUnresolved": ["./src/db/migrations/apply.ts"]
    },
    "apps/cli": {
      "entry": ["src/**/*.test.ts", "__tests__/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["electrobun.config.ts", "src/bun/index.ts"],
      "ignoreDependencies": ["@types/three"]
    },
    "apps/mobile": {
      "entry": ["src/app/**/*.{ts,tsx}", "src/lib/**/*.{ts,tsx}"],
      "ignoreDependencies": ["expo-updates", "expo-system-ui"]
    },
    "apps/server": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "src/db/migrations/apply.ts",
        "src/auth/cli.ts"
      ],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/web": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "src/lib/auth/plugins/**/*.ts",
        "src/components/auth/**/*.tsx"
      ],
      "ignoreIssues": {
        "src/components/ui/**": ["exports", "types"]
      }
    },
    "shared/hooks": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "includeEntryExports": true
    },
    "shared/providers": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "includeEntryExports": true
    },
    "shared/connections": {
      "includeEntryExports": true,
      "ignoreIssues": {
        "package.json": ["optionalPeerDependencies"]
      }
    },
    "shared/*": {
      "includeEntryExports": true
    },
    "shared/schemas": {
      "includeEntryExports": true,
      "ignoreIssues": {
        "src/**": ["types"]
      }
    },
    "tooling/test": {
      "entry": [
        "setup/**/*.ts",
        "mocks/**/*.ts",
        "fixtures/**/*.ts",
        "smoke/**/*.ts"
      ]
    },
    "tooling/typescript": {
      "entry": ["tsconfig.base.json"]
    },
    "tooling/github": {
      "entry": ["setup/action.yml"]
    }
  }
}
