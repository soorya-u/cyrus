{
  "$schema": "https://unpkg.com/wrangler@4.103/config-schema.json",
  "name": "cyrus",
  "main": "apps/server/src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyrus",
      "database_id": "772d7fee-548f-49a4-8c1e-55d0e78c1494",
      "migrations_dir": "apps/server/src/db/migrations",
      "migrations_pattern": "apps/server/src/db/migrations/*/migration.sql"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "Room", "to": "Hub" }]
    }
  ]
}
