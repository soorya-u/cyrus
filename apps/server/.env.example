# Database
DATABASE_URL=

# D1 tooling (`drizzle-kit push` / `studio` against the Worker D1 binding)
# When set, drizzle-kit uses the d1-http driver; otherwise it falls back to D1_LOCAL_DB.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
# Local sqlite file used when Cloudflare D1 credentials are unset
D1_LOCAL_DB=file:./.local/d1/cyrus.sqlite

# Better Auth
BETTER_AUTH_SECRET=

# Server Settings
NODE_ENV=
PRODUCTION_URL=
WEB_APP_URL=

# Oauth
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_PROXY_SECRET=

# CORS & Trusted Origins (comma-separated)
ALLOWED_ORIGINS=
